{
  "name": "ashen-lantern",
  "private": true,
  "version": "1.0.0",
  "description": "Пепельный Фонарь — 2D pixel art action RPG для браузера (Phaser 3 + TypeScript + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@vitest/coverage-v8": "^5.1.1",
    "ajv": "^8.20.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/A160LKN/ashen-lantern.git"
  }
}
